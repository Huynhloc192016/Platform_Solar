# Environment (development | production)
NODE_ENV=development
PORT=5000

# JWT (bắt buộc đổi JWT_SECRET khi deploy production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=7d

# MSSQL
DB_HOST=localhost
DB_PORT=1433
DB_NAME=YourDatabase
DB_USER=sa
DB_PASSWORD=your-password
DB_ENCRYPT=false
DB_TRUST_CERT=true

# CORS: origin frontend (VD: https://your-domain.com hoặc http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# OCPP Server (FocusEV.OCPP.Server) - RemoteStopTransaction
OCPP_SERVER_URL=http://localhost:8481

# Mail (Gmail: SMTP_USER = email, SMTP_PASS = App password)
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
MAIL_FROM=

# Cron gửi mail kiểm tra connector không có session
MAIL_CRON_ENABLED=true
MAIL_CRON_INTERVAL_MINUTES=5

# Tùy chọn: key giải mã mật khẩu legacy (nếu có)
# LEGACY_PASSWORD_KEY=
